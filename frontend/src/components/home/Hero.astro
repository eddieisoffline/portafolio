---
import { formatDate } from "../../lib/formatDate";
import { copy, type Locale } from "../../lib/i18n";
import { siteProfile } from "../../lib/siteContent";
import type { Project } from "../../lib/types";

interface Props {
  locale: Locale;
  projects: Project[];
}

const { locale, projects } = Astro.props;
const t = copy[locale];
---

<div class="intro">
  <h1 class="display display--home"><span class="on-deep">{siteProfile.displayName}</span></h1>
  <div>
    <p class="intro-text">{t.hero.summary}</p>
    {
      projects.length > 0 ? (
        <ol class="key" aria-label={t.hero.indexLabel}>
          {projects.map((project, index) => (
            <li>
              <a href={`#p-${project.slug}`}>
                <b>{index + 1}</b>
                <span>{project.title}</span>
                <em>{formatDate(project.date, locale)}</em>
              </a>
            </li>
          ))}
        </ol>
      ) : null
    }
  </div>
</div>
