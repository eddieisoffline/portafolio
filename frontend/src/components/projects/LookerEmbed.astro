---
interface Props {
  url?: string | null;
  title?: string;
  heading: string;
}

const { url, title = "Looker Studio dashboard", heading } = Astro.props;
---

{
  url ? (
    <section class="dashboard">
      <h2 class="block-title">{heading}</h2>
      <iframe src={url} title={title} loading="lazy" allowfullscreen></iframe>
    </section>
  ) : null
}
