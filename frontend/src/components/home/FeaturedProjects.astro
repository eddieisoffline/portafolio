---
import type { Project } from "../../lib/types";
import { copy, type Locale, withLocale } from "../../lib/i18n";
import ProjectGrid from "../projects/ProjectGrid.astro";
import EmptyState from "../ui/EmptyState.astro";
import ErrorState from "../ui/ErrorState.astro";

interface Props {
  projects: Project[];
  hadError?: boolean;
  locale: Locale;
}

const { projects, locale, hadError = false } = Astro.props;
const t = copy[locale];
---

<section class="problems-wrap" id="projects" aria-labelledby="projects-title">
  <h2 class="sr-only" id="projects-title">{t.home.featuredTitle}</h2>
  {
    hadError ? (
      <ErrorState locale={locale} />
    ) : projects.length > 0 ? (
      <>
        <ProjectGrid projects={projects} locale={locale} headingLevel="h3" />
        <p class="mt-8">
          <a class="text-link" href={withLocale("/projects", locale)}>
            {t.home.viewAllProjects}
          </a>
        </p>
      </>
    ) : (
      <EmptyState title={t.home.noFeaturedTitle} message={t.home.noFeaturedMessage} />
    )
  }
</section>
