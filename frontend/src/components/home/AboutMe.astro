---
import { copy, type Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
---

<section id="about" aria-labelledby="about-title">
  <h2 class="block-title" id="about-title">{t.about.title}</h2>
  <p>{t.about.body}</p>
  <dl class="tools-list" id="stack" aria-label={t.about.toolsLabel}>
    {
      t.stackGroups.map((group) => (
        <div>
          <dt>{group.label}</dt>
          <dd>{group.tools.join(", ")}</dd>
        </div>
      ))
    }
  </dl>
</section>
