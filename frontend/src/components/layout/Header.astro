---
import {
  copy,
  stripLocaleFromPath,
  supportedLocales,
  switchLocalePath,
  type Locale,
  withLocale
} from "../../lib/i18n";
import { siteProfile } from "../../lib/siteContent";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pathname = Astro.url.pathname;
const pathWithoutLocale = stripLocaleFromPath(pathname);
const query = Astro.url.search;
const t = copy[locale];
const siteNav = [
  {
    label: t.nav.projects,
    href: withLocale("/projects", locale),
    isCurrent: pathWithoutLocale.startsWith("/projects")
  },
  {
    label: t.nav.contact,
    href: withLocale("/#contact", locale),
    isCurrent: false
  }
];
---

<header class="topbar">
  <a href={withLocale("/", locale)} class="brand" aria-label={t.nav.homeLabel}>
    {siteProfile.shortName}
  </a>

  <nav aria-label={t.nav.primary}>
    {
      siteNav.map((item) => (
        <a href={item.href} aria-current={item.isCurrent ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
    <span class="lang" aria-label={t.nav.language}>
      {
        supportedLocales.map((item) => (
          <a
            href={`${switchLocalePath(pathname, item)}${query}`}
            hreflang={item}
            aria-current={item === locale ? "true" : undefined}
          >
            {item.toUpperCase()}
          </a>
        ))
      }
    </span>
  </nav>
</header>
