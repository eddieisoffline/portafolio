---
import { formatDate } from "../../lib/formatDate";
import { copy, interpolate, type Locale, withLocale } from "../../lib/i18n";
import type { Project } from "../../lib/types";

interface Props {
  project: Project;
  locale: Locale;
  number: number;
  headingLevel?: "h2" | "h3";
}

const { project, locale, number, headingLevel = "h2" } = Astro.props;
const t = copy[locale];
const Heading = headingLevel;
const projectHref = withLocale(`/projects/${project.slug}`, locale);
const links = [
  { label: t.projects.repo, href: project.repoUrl },
  { label: t.projects.demo, href: project.demoUrl },
  { label: t.projects.dashboard, href: project.dashboardUrl ?? null }
].flatMap((link) => (link.href ? [{ label: link.label, href: link.href }] : []));
const meta = [formatDate(project.date, locale), project.tools.join(", ")]
  .filter(Boolean)
  .join(" · ");
---

<li class="problem" id={`p-${project.slug}`}>
  <div class="ask gridded">
    <div class="ask-top">
      <span class="num">{number}</span>
      {project.featured ? <span class="stamp">{t.projects.featured}</span> : null}
    </div>
    <Heading>
      <a href={projectHref}><span class="hl">{project.title}</span></a>
    </Heading>
    {
      project.summary ? (
        <p class="summary"><span class="hl">{project.summary}</span></p>
      ) : null
    }
    <p class="meta"><span class="hl">{meta}</span></p>
  </div>
  <hr class="fold" />
  <div class="plate">
    {
      project.coverImage ? (
        <figure class="cover">
          <img
            src={project.coverImage}
            alt={interpolate(t.projects.coverAlt, { title: project.title })}
            loading="lazy"
          />
        </figure>
      ) : (
        <div class="tools-plate" aria-hidden="true">
          <ul>
            {(project.tools.length > 0 ? project.tools.slice(0, 4) : [project.title]).map(
              (tool, index) => <li style={`--n:${index}`}>{tool}</li>
            )}
          </ul>
        </div>
      )
    }
    <nav class="links" aria-label={interpolate(t.projects.linksLabel, { title: project.title })}>
      <a href={projectHref}>{t.projects.readCaseStudy}</a>
      {
        links.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</li>
