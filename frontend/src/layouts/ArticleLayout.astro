---
import BaseLayout from "../components/layout/BaseLayout.astro";
import ProjectMeta from "../components/projects/ProjectMeta.astro";
import { copy, interpolate, type Locale, withLocale } from "../lib/i18n";
import type { Project } from "../lib/types";

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = copy[locale];
---

<BaseLayout
  title={project.title}
  description={project.summary ?? project.title}
  locale={locale}
  canonicalPath={withLocale(`/projects/${project.slug}`, locale)}
  image={project.coverImage ?? undefined}
  type="article"
>
  <Fragment slot="hero">
    <a class="back" href={withLocale("/projects", locale)}>{t.projects.back}</a>
    <h1 class="display display--page">{project.title}</h1>
    {project.summary ? <p class="page-lede">{project.summary}</p> : null}
  </Fragment>

  <article class="case-body">
    <div class="min-w-0">
      {
        project.coverImage ? (
          <figure class="case-cover">
            <img
              src={project.coverImage}
              alt={interpolate(t.projects.coverAlt, { title: project.title })}
              loading="eager"
            />
          </figure>
        ) : null
      }
      <slot />
    </div>
    <ProjectMeta project={project} locale={locale} />
  </article>
</BaseLayout>
