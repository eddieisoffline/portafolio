---
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import WordSearch from "./WordSearch.astro";
import { copy, type Locale } from "../../lib/i18n";
import { siteProfile } from "../../lib/siteContent";
import { getSiteOrigin, toAbsoluteUrl } from "../../lib/siteUrl";
import "@fontsource-variable/libre-franklin";
import "@fontsource-variable/source-serif-4/opsz.css";
import "@fontsource-variable/source-serif-4/opsz-italic.css";
import "../../styles/global.css";

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  canonicalPath?: string;
  image?: string;
  type?: "website" | "article";
  wordSearch?: boolean;
}

const {
  title,
  locale,
  canonicalPath,
  image = "/social-card.png",
  type = "website",
  wordSearch = false
} = Astro.props;
const description =
  Astro.props.description ?? copy[locale].site.defaultDescription;
const pageTitle = title.includes(siteProfile.role) ? title : `${title} | ${siteProfile.role}`;
const siteOrigin = getSiteOrigin(Astro.url);
const canonicalUrl = toAbsoluteUrl(canonicalPath ?? Astro.url.pathname, siteOrigin);
const imageUrl = toAbsoluteUrl(image, siteOrigin);
const ogLocale = locale === "es" ? "es_MX" : "en_US";
const alternateLocale = locale === "es" ? "en_US" : "es_MX";
const shouldLoadAnalytics = !import.meta.env.DEV;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#16438a" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content="Eduardo Anica Gonzalez" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="sheet" data-word-search={wordSearch ? "" : undefined}>
      {wordSearch ? <WordSearch tools={copy[locale].stackGroups.flatMap((group) => group.tools)} /> : null}
      <div class:list={["wrap sheet-in", wordSearch && "sheet-in--home"]}>
        <Header locale={locale} />
        <slot name="hero" />
      </div>
    </div>
    <main class="wrap">
      <slot />
    </main>
    <Footer locale={locale} />
    {
      shouldLoadAnalytics ? (
        <script
          is:inline
          defer
          src="/_vercel/insights/script.js"
          data-sdkn="@vercel/analytics/astro"
          data-sdkv="1.6.1"
        ></script>
      ) : null
    }
  </body>
</html>
