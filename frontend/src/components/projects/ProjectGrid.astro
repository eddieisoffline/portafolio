---
import type { Locale } from "../../lib/i18n";
import type { Project } from "../../lib/types";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  projects: Project[];
  locale: Locale;
  start?: number;
  headingLevel?: "h2" | "h3";
}

const { projects, locale, start = 1, headingLevel } = Astro.props;
---

<ol class="problems" start={start}>
  {
    projects.map((project, index) => (
      <ProjectCard
        project={project}
        locale={locale}
        number={start + index}
        headingLevel={headingLevel}
      />
    ))
  }
</ol>
