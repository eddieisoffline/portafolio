---
import { formatDate } from "../../lib/formatDate";
import { copy, type Locale } from "../../lib/i18n";
import type { Project } from "../../lib/types";

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = copy[locale];
const links = [
  { label: t.projects.repo, href: project.repoUrl },
  { label: t.projects.demo, href: project.demoUrl },
  { label: t.projects.dashboard, href: project.dashboardUrl ?? null }
].flatMap((link) => (link.href ? [{ label: link.label, href: link.href }] : []));
---

<dl class="facts">
  <div>
    <dt>{t.projects.date}</dt>
    <dd>{formatDate(project.date, locale)}</dd>
  </div>
  {
    project.tools.length > 0 ? (
      <div>
        <dt>{t.projects.tools}</dt>
        <dd>{project.tools.join(", ")}</dd>
      </div>
    ) : null
  }
  {
    links.length > 0 ? (
      <div>
        <dt>{t.projects.links}</dt>
        <dd>
          {links.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer">
              {link.label}
            </a>
          ))}
        </dd>
      </div>
    ) : null
  }
</dl>
