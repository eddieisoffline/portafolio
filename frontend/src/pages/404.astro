---
export const prerender = false;

import BaseLayout from "../components/layout/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import {
  copy,
  getLocaleFromPath,
  getLocaleFromRequest,
  withLocale
} from "../lib/i18n";

const locale =
  getLocaleFromPath(Astro.url.pathname) ?? getLocaleFromRequest(Astro.request);
const t = copy[locale];

Astro.response.status = 404;
---

<BaseLayout
  title={t.notFound.pageTitle}
  description={t.notFound.pageDescription}
  locale={locale}
  noindex
>
  <Fragment slot="hero">
    <p class="not-found-label">{t.notFound.label}</p>
    <h1 class="display display--page">{t.notFound.headline}</h1>
    <p class="page-lede">{t.notFound.body}</p>
  </Fragment>

  <section class="problems-wrap">
    <p class="not-found-actions">
      <Button href={withLocale("/", locale)}>{t.notFound.home}</Button>
      <a class="text-link" href={withLocale("/projects", locale)}>{t.notFound.projects}</a>
    </p>
  </section>
</BaseLayout>
