---
import { copy, type Locale, withLocale } from "../../lib/i18n";
import { siteProfile, socialLinks } from "../../lib/siteContent";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const visibleSocialLinks = socialLinks.filter((link) => link.href.trim().length > 0);
const t = copy[locale];
---

<footer class="site-footer">
  <div class="wrap">
    <span>{siteProfile.displayName} · {t.hero.role}</span>
    <nav aria-label={t.nav.footer}>
      {
        visibleSocialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">
            {link.label}
          </a>
        ))
      }
      <a href={withLocale("/privacy", locale)}>{t.nav.privacy}</a>
      <a href={withLocale("/legal", locale)}>{t.nav.legal}</a>
      <a href={withLocale("/cookies", locale)}>{t.nav.cookies}</a>
    </nav>
  </div>
</footer>
