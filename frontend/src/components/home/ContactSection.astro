---
import { copy, type Locale } from "../../lib/i18n";
import { socialLinks } from "../../lib/siteContent";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const linkedIn = socialLinks.find((link) => link.label === "LinkedIn" && link.href.trim());
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <h2 class="block-title" id="contact-title">{t.contact.title}</h2>
  <p>
    {t.contact.description}
    {
      linkedIn ? (
        <>
          {" "}
          {t.contact.orOn}{" "}
          <a href={linkedIn.href} target="_blank" rel="noreferrer">LinkedIn</a>.
        </>
      ) : "."
    }
  </p>

  <form data-contact-form novalidate>
    <div class="field">
      <label for="contact-name">{t.contact.nameLabel}</label>
      <input
        id="contact-name"
        name="name"
        type="text"
        maxlength="120"
        required
        autocomplete="name"
        placeholder={t.contact.namePlaceholder}
      />
    </div>

    <div class="field">
      <label for="contact-email">{t.contact.emailLabel}</label>
      <input
        id="contact-email"
        name="email"
        type="email"
        maxlength="254"
        required
        autocomplete="email"
        placeholder={t.contact.emailPlaceholder}
      />
    </div>

    <div class="field">
      <label for="contact-message">{t.contact.messageLabel}</label>
      <textarea
        id="contact-message"
        name="message"
        maxlength="3000"
        required
        rows="5"
        placeholder={t.contact.messagePlaceholder}
      ></textarea>
    </div>

    <div class="hidden" aria-hidden="true">
      <label for="contact-company">{t.contact.companyLabel}</label>
      <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-foot">
      <button class="btn" type="submit">
        <span data-submit-label>{t.contact.submit}</span>
      </button>
      <p
        class="status"
        data-contact-status
        data-success={t.contact.success}
        data-error={t.contact.error}
        data-validation-error={t.contact.validationError}
        data-submitting={t.contact.submitting}
        aria-live="polite"
      ></p>
    </div>
  </form>
</section>

<script is:inline src="/scripts/contact-form.js" defer></script>
