---
interface Props {
  href?: string;
  external?: boolean;
  class?: string;
  type?: "button" | "submit" | "reset";
}

const { href, external = false, class: className = "", type = "button" } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class:list={["btn", className]}
      target={external ? "_blank" : undefined}
      rel={external ? "noreferrer" : undefined}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class:list={["btn", className]}>
      <slot />
    </button>
  )
}
