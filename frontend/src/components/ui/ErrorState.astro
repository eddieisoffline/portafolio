---
import { copy, type Locale } from "../../lib/i18n";

interface Props {
  title?: string;
  message?: string;
  locale?: Locale;
}

const {
  locale = "en",
  title = copy[locale].states.dataUnavailable,
  message = copy[locale].states.dataUnavailableMessage
} = Astro.props;
---

<div class="notice notice--error" role="status">
  <h3>{title}</h3>
  <p>{message}</p>
</div>
